CREATOR_ID=0
KSUSHA_ID=0
BOT_TOKEN=
BOT_SITE_URL=https://surememory.ru
SITE_DIRECT_URL=https://surememory.ru
HTTP_HOST=0.0.0.0
# Note: port 25086 must NOT be published to the host in docker-compose.yml (no "ports:" mapping).
# cloudflared reaches the app via Docker internal network. Direct IP access is blocked that way.
HTTP_PORT=25086
SITE_AUTH_PASSWORD_KSYUSHA=
SITE_AUTH_PASSWORD_CREATOR=
API_SECRET_KEY=
MEDIA_ACCESS_TOKEN=
GPTUNNEL_API_KEY=

# Optional runtime
RUN_STARTUP_TESTS=0
SECRETS_STRICT=1
CLOUDFLARED_PATH=/app/cloudflared
CLOUDFLARED_TUNNEL_NAME=memories
DATABASE_PATH=/app/data/memories.db
HOT_BACKUP_ENABLED=1
HOT_BACKUP_PATH=/app/data/memories.hotbackup.db
MEDIA_FOLDER=/app/media
COMPOSE_PROJECT_NAME=workspace

CLOUDFLARED_TOKEN=
